<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <Style src="project://database/Assets/UI/Styles/IVR.uss?fileID=7433441132597879392&amp;guid=25b4ab05848a26796a2f91450bb3cddd&amp;type=3" />
    <Style src="project://database/Assets/UI/Styles/Hub.uss?fileID=7433441132597879392&amp;guid=9317b0bb0e4a458ba3cae1ea5db3b068&amp;type=3" />
    <ui:VisualElement name="HubScreen" class="hub-screen">
        <ui:VisualElement class="hub-shell">
            <ui:VisualElement class="hub-topbar">
                <ui:VisualElement class="hub-brand">
                    <ui:Label text="A" class="hub-logo" />
                    <ui:Label text="Игра о финансах" class="hub-brand-text" />
                </ui:VisualElement>
                <ui:VisualElement class="hub-top-actions">
                    <ui:Button name="top-streak" class="hub-streak-pill hub-top-pill">
                        <ui:VisualElement class="hub-counter-icon hub-fire-icon" />
                        <ui:Label name="top-streak-value" text="—" class="hub-counter-value" />
                    </ui:Button>
                    <ui:Button name="top-coins" class="hub-coin-pill hub-top-pill">
                        <ui:VisualElement class="hub-counter-icon hub-coin-icon" />
                        <ui:Label name="top-coins-value" text="0" class="hub-counter-value" />
                    </ui:Button>
                    <ui:Label name="top-score" text="0 очков" class="hub-score-pill" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:ScrollView name="hub-scroll" class="hub-scroll">
                <ui:VisualElement name="tab-home" class="hub-page hub-home-page">
                    <ui:VisualElement name="home-fixed-panel" class="hub-home-fixed-panel">
                        <ui:VisualElement class="hub-greeting-row">
                            <ui:VisualElement>
                                <ui:Label name="home-greeting" text="Привет!" class="hub-title" />
                                <ui:Label text="Продолжим путь к финансовым знаниям?" class="hub-subtitle" />
                            </ui:VisualElement>
                            <ui:Button name="home-avatar" text="А" class="hub-avatar" />
                        </ui:VisualElement>
                        <ui:VisualElement class="hub-feature hub-home-feature">
                            <ui:Label name="home-level" text="УРОВЕНЬ 1" class="hub-feature-eyebrow" />
                            <ui:Label name="home-selected-title" text="Накопления" class="hub-feature-title" />
                            <ui:Label name="home-selected-summary" text="Как приблизиться к денежной цели" class="hub-feature-copy" />
                            <ui:Button name="home-start-quiz" text="Открыть урок →" class="hub-feature-button" />
                        </ui:VisualElement>
                        <ui:VisualElement class="hub-stats-row hub-home-stats">
                            <ui:VisualElement class="hub-stat">
                                <ui:Label name="home-score" text="0" class="hub-stat-value" />
                                <ui:Label text="очков знаний" class="hub-stat-label" />
                            </ui:VisualElement>
                            <ui:VisualElement class="hub-stat">
                                <ui:Label name="home-lessons" text="0/11" class="hub-stat-value" />
                                <ui:Label text="тем пройдено" class="hub-stat-label" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:Label text="Дорожка уроков" class="hub-section-title hub-home-path-title" />
                        <ui:Label text="Нажми на кружок, чтобы выбрать тему" class="hub-muted hub-path-help" />
                    </ui:VisualElement>
                    <ui:ScrollView name="home-level-scroll" class="hub-level-scroll">
                        <ui:VisualElement name="home-topic-list" class="hub-level-path" />
                    </ui:ScrollView>
                </ui:VisualElement>

                <ui:VisualElement name="tab-learn" class="hub-page">
                    <ui:Label text="Твои уроки" class="hub-title" />
                    <ui:Label text="Разборы ошибок и темы для закрепления" class="hub-subtitle" />
                    <ui:VisualElement name="lesson-list" class="hub-list">
                        <ui:Button name="learning-diagnostic" text="Пройти вводный тест →" class="hub-primary" style="display: none;" />
                        <ui:Label name="learning-knowledge" text="" class="hub-muted" />
                        <ui:VisualElement class="hub-section-row">
                            <ui:Label text="Лично для тебя" class="hub-section-title" />
                            <ui:Button name="learning-refresh" text="Обновить" class="hub-text-button" />
                        </ui:VisualElement>
                        <ui:Label name="learning-status" text="" class="hub-muted" />
                        <ui:VisualElement name="personal-lesson-list" class="hub-list" />
                        <ui:Label text="Все темы" class="hub-section-title" />
                        <ui:VisualElement name="lesson-topic-list" class="hub-list" />
                    </ui:VisualElement>
                    <ui:VisualElement name="lesson-detail" class="hub-lesson-detail" style="display: none;">
                        <ui:Button name="lesson-back" text="‹  Все темы" class="hub-text-button" />
                        <ui:Label name="lesson-title" text="" class="hub-title" />
                        <ui:Label name="lesson-summary" text="" class="hub-subtitle" />
                        <ui:Label name="lesson-progress" text="Материал" class="hub-muted" />
                        <ui:VisualElement name="lesson-fallback-card" class="hub-reading-card">
                            <ui:Label name="lesson-body" text="" class="hub-reading-text" />
                        </ui:VisualElement>
                        <ui:VisualElement name="lesson-ai-content" class="hub-story-content" style="display: none;">
                            <ui:VisualElement name="lesson-story-step" class="hub-story-content">
                                <ui:VisualElement name="lesson-character-card" class="hub-character-card">
                                    <ui:Label name="lesson-character-avatar" text="М" class="hub-story-avatar" />
                                    <ui:VisualElement class="hub-story-character-copy">
                                        <ui:Label name="lesson-character-name" text="Мира, 17 лет" class="hub-story-character-name" />
                                        <ui:Label name="lesson-character-personality" text="внимательная" class="hub-muted" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement class="hub-reading-card hub-story-card">
                                    <ui:Label text="ТВОЯ ИСТОРИЯ" class="hub-story-eyebrow" />
                                    <ui:Label name="lesson-story" text="" class="hub-reading-text hub-story-text" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement name="lesson-learning-step" class="hub-story-content" style="display: none;">
                                <ui:VisualElement class="hub-takeaway-card">
                                    <ui:Label text="Что важно запомнить" class="hub-story-section-title" />
                                    <ui:Label name="lesson-takeaway" text="" class="hub-reading-text" />
                                </ui:VisualElement>
                                <ui:VisualElement name="lesson-terms-group">
                                    <ui:Label text="Новые термины" class="hub-story-section-title" />
                                    <ui:VisualElement name="lesson-terms-list" class="hub-list" />
                                </ui:VisualElement>
                                <ui:VisualElement class="hub-cheatsheet-card">
                                    <ui:Label text="Шпаргалка" class="hub-story-section-title" />
                                    <ui:Label name="lesson-cheatsheet" text="" class="hub-reading-text" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:Button name="lesson-story-next" text="Перейти к разбору →" class="hub-primary" style="display: none;" />
                        <ui:Button name="lesson-learning-back" text="‹  Вернуться к истории" class="hub-text-button" style="display: none;" />
                        <ui:Button name="lesson-quiz" text="Проверить знания →" class="hub-primary" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement name="tab-minigames" class="hub-page">
                    <ui:VisualElement name="minigame-catalog">
                        <ui:Label text="Мини-игры" class="hub-title" />
                        <ui:Label text="Короткие игровые тренировки по финансовой грамотности" class="hub-subtitle" />
                        <ui:VisualElement class="hub-minigame-hero">
                            <ui:Label text="СТРОЙ СВОЮ КОМПАНИЮ" class="hub-feature-eyebrow" />
                            <ui:Label text="Кликер «Офис мечты» уже доступен" class="hub-feature-title" />
                            <ui:Label text="Начни с кликов, а затем мы добавим отделы, сотрудников и пассивный доход." class="hub-feature-copy" />
                        </ui:VisualElement>
                        <ui:Button name="games-market" text="Открыть виртуальную биржу →" class="hub-outline hub-games-market" />
                        <ui:VisualElement name="minigame-list" class="hub-list" />
                    </ui:VisualElement>
                    <ui:VisualElement name="office-clicker" class="hub-clicker-screen" style="display: none;">
                        <ui:Button name="office-clicker-button" text="РАЗВИВАТЬ ОФИС" class="hub-clicker-button" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement name="tab-quests" class="hub-page">
                    <ui:Label text="Задания" class="hub-title" />
                    <ui:Label text="Цели растут вместе с твоим прогрессом" class="hub-subtitle" />
                    <ui:VisualElement class="hub-quest-banner">
                        <ui:Label text="ЕЖЕДНЕВНЫЕ ЗАДАНИЯ" class="hub-feature-eyebrow" />
                        <ui:Label name="quest-summary" text="0 из 2 заданий выполнено" class="hub-feature-title" />
                        <ui:Label name="quest-streak" text="Серия входов: 1 · рекорд: 1" class="hub-feature-copy" />
                    </ui:VisualElement>
                    <ui:VisualElement class="hub-filters">
                        <ui:Button name="quest-all" text="Все" class="hub-filter hub-filter-active" />
                        <ui:Button name="quest-active" text="В процессе" class="hub-filter" />
                        <ui:Button name="quest-done" text="Готово" class="hub-filter" />
                    </ui:VisualElement>
                    <ui:VisualElement name="quest-list" class="hub-list" />
                </ui:VisualElement>

                <ui:VisualElement name="tab-rating" class="hub-page">
                    <ui:Label text="Рейтинг" class="hub-title" />
                    <ui:Label text="Игроки по стоимости виртуального портфеля" class="hub-subtitle" />
                    <ui:VisualElement name="rating-podium" class="hub-podium" />
                    <ui:VisualElement class="hub-section-row">
                        <ui:Label text="Все игроки" class="hub-section-title" />
                        <ui:Button name="rating-refresh" text="Обновить" class="hub-text-button" />
                    </ui:VisualElement>
                    <ui:VisualElement name="rating-list" class="hub-list" />
                    <ui:Label name="rating-status" text="" class="hub-muted" />
                </ui:VisualElement>

                <ui:VisualElement name="tab-profile" class="hub-page">
                    <ui:Label text="Профиль" class="hub-title" />
                    <ui:VisualElement class="hub-profile-head">
                        <ui:Label text="А" class="hub-avatar hub-avatar-large" />
                        <ui:VisualElement>
                            <ui:Label name="profile-name" text="Игрок" class="hub-section-title" />
                            <ui:Label name="profile-email" text="" class="hub-muted" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="hub-profile-card">
                        <ui:Label name="profile-level" text="Уровень 1" class="hub-profile-value" />
                        <ui:Label name="profile-score" text="0 очков" class="hub-profile-value" />
                        <ui:Label name="profile-interests" text="Интересы: —" class="hub-muted" />
                    </ui:VisualElement>
                    <ui:VisualElement class="hub-profile-card">
                        <ui:Label text="Виртуальный портфель" class="hub-section-title" />
                        <ui:Label name="profile-portfolio" text="Загрузка..." class="hub-profile-value" />
                    </ui:VisualElement>
                    <ui:Button name="profile-quiz" text="Пройти квиз →" class="hub-primary" />
                    <ui:Button name="profile-market" text="Открыть биржу" class="hub-outline" />
                    <ui:Button name="profile-interests-button" text="Изменить интересы" class="hub-outline" />
                    <ui:Button name="profile-logout" text="Выйти из аккаунта" class="hub-text-button hub-logout" />
                </ui:VisualElement>

                <ui:VisualElement name="tab-market" class="hub-page">
                    <ui:Button name="market-back" text="‹  На главную" class="hub-text-button" />
                    <ui:Label text="Виртуальная биржа" class="hub-title" />
                    <ui:Label text="Тренируй решения на игровых деньгах" class="hub-subtitle" />
                    <ui:VisualElement class="hub-market-balance">
                        <ui:Label name="market-day" text="День 0" class="hub-muted" />
                        <ui:Label name="market-cash" text="Деньги: —" class="hub-profile-value" />
                        <ui:Label name="market-total" text="Капитал: —" class="hub-profile-value" />
                    </ui:VisualElement>
                    <ui:Label text="Акции" class="hub-section-title" />
                    <ui:VisualElement name="market-stock-list" class="hub-list" />
                    <ui:VisualElement name="market-detail" class="hub-profile-card" style="display: none;">
                        <ui:Label name="market-selected" text="" class="hub-section-title" />
                        <ui:Label name="market-position" text="" class="hub-muted" />
                        <ui:IntegerField name="market-quantity" label="Количество" value="1" class="hub-market-quantity" />
                        <ui:VisualElement class="hub-market-actions">
                            <ui:Button name="market-buy" text="Купить" class="hub-market-action hub-market-buy" />
                            <ui:Button name="market-sell" text="Продать" class="hub-market-action" />
                            <ui:Button name="market-short" text="Шорт" class="hub-market-action" />
                            <ui:Button name="market-cover" text="Закрыть шорт" class="hub-market-action" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Label name="market-status" text="" class="hub-muted" />
                    <ui:Label text="Новости рынка" class="hub-section-title" />
                    <ui:VisualElement name="market-news-list" class="hub-list" />
                </ui:VisualElement>
            </ui:ScrollView>

            <ui:VisualElement name="hub-nav" class="hub-nav">
                <ui:Button name="nav-home" text="Главная" class="hub-nav-button" />
                <ui:Button name="nav-learn" text="Уроки" class="hub-nav-button" />
                <ui:Button name="nav-minigames" text="Игры" class="hub-nav-button" />
                <ui:Button name="nav-quests" text="Задания" class="hub-nav-button" />
                <ui:Button name="nav-rating" text="Рейтинг" class="hub-nav-button" />
                <ui:Button name="nav-profile" text="Профиль" class="hub-nav-button" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="streak-rewards-overlay" class="hub-overlay" style="display: none;">
            <ui:VisualElement class="hub-result-card hub-economy-card">
                <ui:Label text="Награды за серию" class="hub-title" />
                <ui:Label name="streak-current" text="Текущая серия: —" class="hub-subtitle" />
                <ui:Label name="streak-next" text="Загружаем следующую награду…" class="hub-economy-highlight" />
                <ui:Label name="streak-reward-7" text="7 дней · 4 коина · 2000 на бирже" class="hub-reward-row" />
                <ui:Label name="streak-reward-14" text="14 дней · 8 коинов · 3000 на бирже" class="hub-reward-row" />
                <ui:Label name="streak-reward-status" text="" class="hub-muted hub-economy-status" />
                <ui:Button name="streak-reward-claim" text="Получить награду" class="hub-primary" />
                <ui:Button name="streak-reward-close" text="Закрыть" class="hub-text-button hub-modal-close" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="coin-shop-overlay" class="hub-overlay" style="display: none;">
            <ui:VisualElement class="hub-result-card hub-economy-card">
                <ui:Label text="Магазин коинов" class="hub-title" />
                <ui:Label name="coin-shop-balance" text="Баланс: 0 коинов" class="hub-economy-highlight" />
                <ui:Label text="Обменяй один коин на игровую валюту для виртуальной биржи." class="hub-subtitle" />
                <ui:Label text="1 коин = 1000 ₸ на бирже" class="hub-reward-row" />
                <ui:Label name="coin-shop-status" text="" class="hub-muted hub-economy-status" />
                <ui:Button name="coin-shop-exchange" text="Обменять 1 коин → 1000 ₸" class="hub-primary" />
                <ui:Button name="coin-shop-close" text="Закрыть" class="hub-text-button hub-modal-close" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="hub-result-overlay" class="hub-overlay" style="display: none;">
            <ui:VisualElement class="hub-result-card">
                <ui:Label name="hub-result-title" text="Квиз завершён" class="hub-title" />
                <ui:Label name="hub-result-score" text="+0 очков" class="hub-result-score" />
                <ui:Label name="hub-result-message" text="" class="hub-subtitle" />
                <ui:Button name="hub-result-close" text="Продолжить" class="hub-primary" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
