<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <Style src="project://database/Assets/UI/Styles/IVR.uss?fileID=7433441132597879392&amp;guid=25b4ab05848a26796a2f91450bb3cddd&amp;type=3" />
    <ui:VisualElement name="LoginScreen" class="entry-screen">
        <ui:ScrollView class="entry-scroll">
            <ui:VisualElement class="entry-shell">
                <ui:VisualElement class="entry-header">
                    <ui:Button name="back-btn" text="‹" class="entry-back" />
                    <ui:VisualElement class="entry-brand">
                        <ui:Label text="A" class="entry-logo" />
                        <ui:Label text="Игра о банковских продуктах" class="entry-brand-name" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="entry-form-top">
                    <ui:Label text="С возвращением!" class="entry-title" />
                    <ui:Label text="Войди и продолжай свой путь к финансовым знаниям." class="entry-copy" />
                    <ui:VisualElement class="entry-mini-art">
                        <ui:Label text="₸" class="entry-mini-coin" />
                        <ui:Label text="Твои достижения ждут тебя" class="entry-mini-caption" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="entry-form">
                    <ui:Label text="Электронная почта" class="entry-field-label" />
                    <ui:TextField name="email-field" placeholder-text="name@example.com" class="entry-input" />
                    <ui:Label text="Пароль" class="entry-field-label" />
                    <ui:TextField name="password-field" placeholder-text="Введи пароль" password="true" class="entry-input" />
                    <ui:Label name="status-text" text="" class="entry-status" />
                    <ui:Button name="login-btn" text="Войти →" class="entry-primary" />
                    <ui:Button name="register-btn" text="Создать аккаунт" class="entry-link" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
