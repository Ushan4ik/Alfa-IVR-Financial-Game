/* ─── Общие ─────────────────────────── */

.screen {
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    background-color: rgb(18, 18, 30);
}

/* Пятишаговое приветствие, которое можно повторно открыть из профиля. */
.welcome-tour {
    width: 100%;
    height: 100%;
    flex-grow: 1;
    padding: 34px 28px 24px 28px;
    background-color: rgb(249, 247, 248);
}

.welcome-tour-header {
    width: 100%;
}

.welcome-tour-kicker {
    color: rgb(242, 0, 48);
    font-size: 13px;
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.welcome-tour-step {
    color: rgb(115, 110, 116);
    font-size: 12px;
    margin-bottom: 9px;
}

.welcome-tour-progress {
    width: 100%;
    height: 4px;
    border-radius: 3px;
    background-color: rgb(218, 214, 218);
}

.welcome-tour-progress-fill {
    width: 20%;
    height: 4px;
    border-radius: 3px;
    background-color: rgb(242, 0, 48);
}

.welcome-tour-body {
    flex-grow: 1;
    justify-content: center;
}

.welcome-tour-art {
    height: 300px;
    margin-bottom: 38px;
    border-radius: 28px;
    background-color: rgb(255, 232, 236);
    align-items: center;
    justify-content: center;
}

.welcome-tour-symbol {
    width: 162px;
    height: 162px;
    border-radius: 82px;
    border-width: 7px;
    border-color: rgb(255, 157, 174);
    background-color: rgb(242, 0, 48);
    color: white;
    font-size: 70px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.welcome-tour-title {
    color: rgb(14, 14, 16);
    font-size: 35px;
    -unity-font-style: bold;
    white-space: normal;
    margin-bottom: 18px;
}

.welcome-tour-copy {
    color: rgb(104, 100, 106);
    font-size: 17px;
    white-space: normal;
}

.welcome-tour-footer {
    flex-direction: row;
    padding-top: 22px;
}

.welcome-tour-back,
.welcome-tour-next {
    height: 54px;
    border-radius: 8px;
    font-size: 15px;
    -unity-font-style: bold;
}

.welcome-tour-back {
    width: 31%;
    margin-right: 12px;
    border-width: 1px;
    border-color: rgb(242, 0, 48);
    background-color: transparent;
    color: rgb(210, 0, 42);
}

.welcome-tour-next {
    flex-grow: 1;
    border-width: 0;
    background-color: rgb(242, 0, 48);
    color: white;
}

.card {
    width: 420px;
    background-color: rgb(30, 30, 46);
    border-radius: 16px;
    padding: 32px;
}

.title {
    font-size: 28px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    margin-bottom: 24px;
    -unity-text-align: upper-center;
}

.subtitle {
    font-size: 14px;
    color: rgb(160, 160, 180);
    margin-bottom: 20px;
    -unity-text-align: upper-center;
}

/* ─── Поля ввода ─────────────────────── */

.input-field {
    margin-bottom: 16px;
    border-radius: 8px;
    border-width: 1px;
    border-color: rgb(60, 60, 90);
    background-color: rgb(40, 40, 60);
    color: white;
    font-size: 16px;
    padding: 12px;
    height: 48px;
}

.input-field:focus {
    border-color: rgb(120, 100, 255);
}

/* ─── Кнопки ─────────────────────────── */

.btn-primary {
    height: 48px;
    border-radius: 8px;
    background-color: rgb(120, 100, 255);
    color: white;
    font-size: 16px;
    -unity-font-style: bold;
    border-width: 0;
    margin-top: 8px;
}

.btn-primary:hover {
    background-color: rgb(140, 120, 255);
}

.btn-secondary {
    height: 48px;
    border-radius: 8px;
    background-color: transparent;
    color: rgb(120, 100, 255);
    font-size: 16px;
    border-width: 1px;
    border-color: rgb(120, 100, 255);
    margin-top: 8px;
}

/* ─── Статус / ошибки ────────────────── */

.status-text {
    font-size: 13px;
    color: rgb(160, 160, 180);
    -unity-text-align: upper-center;
    margin-top: 12px;
    white-space: normal;
}

.status-error {
    color: rgb(255, 100, 100);
}

/* ─── Профиль ────────────────────────── */

.profile-row {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 12px;
    border-bottom-width: 1px;
    border-color: rgb(50, 50, 70);
    padding-bottom: 12px;
}

.profile-label {
    font-size: 14px;
    color: rgb(160, 160, 180);
}

.profile-value {
    font-size: 14px;
    color: white;
    -unity-font-style: bold;
}

.spacer {
    height: 16px;
}

/* Приветствие, регистрация и вход. Узкий холст повторяет мобильные макеты. */
.entry-screen {
    width: 100%;
    height: 100%;
    flex-grow: 1;
    background-color: rgb(244, 244, 245);
    align-items: center;
}

.entry-scroll {
    width: 100%;
    height: 100%;
}

.entry-shell {
    width: 100%;
    min-height: 100%;
    flex-grow: 1;
    align-self: center;
    background-color: white;
    padding-left: 26px;
    padding-right: 26px;
    padding-top: 24px;
    padding-bottom: 24px;
}

.entry-header {
    height: 48px;
    flex-direction: row;
    align-items: center;
}

.entry-brand {
    flex-direction: row;
    align-items: center;
}

.entry-logo {
    width: 31px;
    height: 31px;
    border-radius: 7px;
    background-color: rgb(242, 0, 48);
    color: white;
    font-size: 21px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-right: 9px;
}

.entry-brand-name {
    color: rgb(30, 30, 32);
    font-size: 14px;
    -unity-font-style: bold;
}

.entry-back {
    width: 34px;
    height: 34px;
    margin-right: 8px;
    background-color: transparent;
    border-width: 0;
    color: rgb(30, 30, 32);
    font-size: 28px;
    -unity-text-align: middle-center;
}

.welcome-screen {
    background-color: rgb(239, 239, 240);
}

.welcome-shell {
    padding-left: 28px;
    padding-right: 28px;
    padding-top: 26px;
    padding-bottom: 18px;
}

.welcome-header {
    height: 62px;
}

.welcome-brand-logo {
    width: 46px;
    height: 46px;
    border-radius: 10px;
    margin-right: 18px;
    align-items: center;
    justify-content: center;
}

.welcome-brand-letter {
    height: 29px;
    color: white;
    font-size: 30px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.welcome-brand-line {
    width: 22px;
    height: 4px;
    background-color: white;
}

.welcome-brand-name {
    color: rgb(14, 14, 16);
    font-size: 19px;
}

.welcome-hero {
    flex-grow: 1;
    justify-content: center;
    padding-top: 5px;
}

.welcome-art {
    height: 264px;
    margin-bottom: 3px;
    position: relative;
    align-items: center;
    justify-content: center;
}

.welcome-card {
    width: 151px;
    height: 200px;
    margin-left: 25px;
    border-radius: 17px;
    background-color: rgb(244, 24, 37);
    padding: 20px;
    justify-content: center;
    align-items: center;
    border-bottom-width: 7px;
    border-bottom-color: rgb(194, 0, 26);
    rotate: 10deg;
}

.welcome-card-mark {
    align-items: center;
}

.welcome-card-logo {
    height: 57px;
    color: white;
    font-size: 54px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.welcome-card-line {
    width: 43px;
    height: 7px;
    background-color: white;
}

.welcome-cashback {
    position: absolute;
    right: -24px;
    bottom: 20px;
    height: 31px;
    padding-left: 10px;
    padding-right: 10px;
    border-radius: 5px;
    background-color: rgb(95, 255, 0);
    color: rgb(10, 10, 10);
    font-size: 17px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    rotate: -7deg;
}

.welcome-coin {
    position: absolute;
    right: 28px;
    top: 67px;
    width: 100px;
    height: 100px;
    border-radius: 50px;
    border-width: 8px;
    border-color: rgb(105, 137, 167);
    background-color: rgb(160, 184, 202);
    align-items: center;
    justify-content: center;
    rotate: 8deg;
}

.welcome-coin-text {
    color: rgb(236, 244, 248);
    font-size: 49px;
    -unity-font-style: bold;
}

.welcome-spark {
    position: absolute;
    width: 25px;
    height: 25px;
    border-radius: 5px;
    rotate: 45deg;
}

.welcome-spark-green {
    left: 49px;
    top: 72px;
    width: 38px;
    height: 38px;
    background-color: rgb(100, 230, 73);
}

.welcome-spark-red {
    left: 46px;
    top: 164px;
    background-color: rgb(242, 51, 46);
}

.welcome-spark-blue {
    left: 92px;
    top: 179px;
    width: 19px;
    height: 19px;
    background-color: rgb(76, 119, 250);
}

.welcome-title {
    margin-bottom: 13px;
}

.welcome-title-line {
    height: 42px;
    color: rgb(8, 8, 9);
    font-size: 39px;
    -unity-font-style: bold;
}

.welcome-title-accent {
    color: rgb(242, 0, 48);
}

.welcome-copy {
    color: rgb(132, 132, 136);
    font-size: 16px;
}

.entry-copy {
    color: rgb(110, 110, 115);
    font-size: 15px;
    white-space: normal;
}

.welcome-footer {
    padding-top: 16px;
}

.welcome-benefits {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 18px;
}

.welcome-benefit {
    width: 31%;
    height: 106px;
    border-radius: 14px;
    background-color: rgb(5, 5, 6);
    justify-content: flex-end;
    padding-left: 12px;
    padding-bottom: 10px;
}

.welcome-benefit-icon {
    width: 48px;
    height: 40px;
    margin-bottom: 1px;
    -unity-background-scale-mode: scale-to-fit;
}

.welcome-gamepad-icon {
    background-image: resource("UI/Icons/welcome-gamepad");
}

.welcome-coin-icon {
    background-image: resource("UI/Icons/coin");
}

.welcome-benefit-emoji {
    height: 42px;
    font-size: 34px;
    -unity-text-align: middle-left;
}

.welcome-benefit-number {
    height: 30px;
    color: rgb(98, 255, 0);
    font-size: 29px;
    -unity-font-style: bold;
}

.welcome-benefit-caption {
    color: rgb(150, 150, 153);
    font-size: 12px;
}

.entry-primary {
    width: 100%;
    height: 52px;
    border-width: 0;
    border-radius: 7px;
    background-color: rgb(242, 0, 48);
    color: white;
    font-size: 15px;
    -unity-font-style: bold;
}

.entry-primary:hover {
    background-color: rgb(210, 0, 40);
}

.entry-link {
    width: 100%;
    height: 43px;
    border-width: 0;
    background-color: transparent;
    color: rgb(208, 0, 42);
    font-size: 14px;
}

.entry-form-top {
    margin-top: 34px;
    margin-bottom: 25px;
}

.entry-title {
    color: rgb(28, 28, 31);
    font-size: 31px;
    -unity-font-style: bold;
    white-space: normal;
    margin-bottom: 10px;
}

.entry-step-row {
    height: 4px;
    flex-direction: row;
    margin-bottom: 29px;
}

.entry-step, .entry-step-active {
    flex-grow: 1;
    height: 4px;
    margin-right: 5px;
    border-radius: 2px;
    background-color: rgb(220, 220, 223);
}

.entry-step-active {
    background-color: rgb(242, 0, 48);
}

.entry-form {
    flex-grow: 1;
}

.entry-field-label {
    color: rgb(35, 35, 38);
    font-size: 14px;
    -unity-font-style: bold;
    margin-bottom: 7px;
}

.entry-input {
    height: 49px;
    margin-bottom: 18px;
    border-radius: 8px;
    border-width: 1px;
    border-color: rgb(218, 218, 221);
    background-color: rgb(249, 249, 250);
    color: rgb(30, 30, 32);
    font-size: 15px;
}

.entry-input:focus {
    border-color: rgb(242, 0, 48);
}

.entry-status {
    min-height: 23px;
    color: rgb(75, 75, 80);
    font-size: 13px;
    white-space: normal;
    margin-bottom: 8px;
}

.entry-status.status-error {
    color: rgb(208, 0, 42);
}

.entry-mini-art {
    height: 118px;
    margin-top: 28px;
    border-radius: 14px;
    background-color: rgb(255, 236, 239);
    flex-direction: row;
    align-items: center;
    padding-left: 23px;
}

.entry-mini-coin {
    width: 67px;
    height: 67px;
    border-radius: 36px;
    background-color: rgb(238, 177, 68);
    color: white;
    font-size: 36px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    margin-right: 17px;
}

.entry-mini-caption {
    flex-grow: 1;
    color: rgb(36, 36, 40);
    font-size: 18px;
    -unity-font-style: bold;
    white-space: normal;
}

/* Шаги знакомства после регистрации */
.onboarding-shell {
    justify-content: space-between;
}

.onboarding-header {
    height: 40px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.onboarding-step-text {
    color: rgb(115, 110, 116);
    font-size: 12px;
}

.onboarding-skip {
    width: 94px;
    height: 34px;
    font-size: 12px;
}

.onboarding-progress-track {
    width: 100%;
    height: 4px;
    margin-top: 8px;
    border-radius: 3px;
    background-color: rgb(223, 220, 224);
}

.onboarding-progress-fill {
    width: 20%;
    height: 4px;
    border-radius: 3px;
    background-color: rgb(242, 0, 48);
}

.onboarding-body {
    flex-grow: 1;
    justify-content: center;
    padding-top: 20px;
}

.onboarding-art {
    height: 210px;
    margin-bottom: 36px;
    border-radius: 17px;
    background-color: rgb(255, 238, 241);
    align-items: center;
    justify-content: center;
}

.onboarding-art-symbol {
    width: 132px;
    height: 132px;
    border-radius: 68px;
    border-width: 7px;
    border-color: rgb(255, 193, 204);
    background-color: rgb(242, 0, 48);
    color: white;
    font-size: 54px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.onboarding-interests {
    margin-top: 24px;
}

.onboarding-interests-input {
    min-height: 108px;
    white-space: normal;
}

.onboarding-footer {
    padding-top: 20px;
}
