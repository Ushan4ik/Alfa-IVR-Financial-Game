# Copy to .env and replace the placeholders. Never commit .env.
IVR_DB_PASSWORD=replace-with-a-local-password

# Register this account normally first, then restart Spring to grant ADMIN.
IVR_ADMIN_EMAILS=admin@example.com

# Optional personalized lesson generation.
GEMINI_API_KEY=
GEMINI_MODEL=

# FinStory runs in safe demo mode by default. Set FINSTORY_DEMO=0 only after
# creating a new server-side Yandex key. Never commit the real key.
FINSTORY_DEMO=1
FINSTORY_INTERNAL_TOKEN=local-development-token-change-before-deploy
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
FINSTORY_YANDEX_MODEL=aliceai-llm
FINSTORY_TERM_MODEL=0

# Calendar day used for login streaks and daily quests.
DAILY_ZONE=Europe/Moscow
