# Скопируй этот файл в application.properties и заполни значения
# cp application.properties.example application.properties

spring.application.name=ivr-backend

# --- PostgreSQL (Supabase) ------------------
spring.datasource.url=jdbc:postgresql://YOUR_HOST:5432/postgres
spring.datasource.username=postgres
spring.datasource.password=YOUR_PASSWORD
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.show-sql=false
spring.flyway.enabled=true
spring.flyway.baseline-on-migrate=true
spring.flyway.baseline-version=1

# --- JWT ------------------------------------
# Минимум 32 символа, придумай сам
jwt.secret=REPLACE_WITH_RANDOM_STRING_MIN_32_CHARS

# Existing registered accounts that should receive ADMIN on application startup.
# Leave empty for no automatic promotion. Separate multiple emails with commas.
security.bootstrap-admin-emails=${IVR_ADMIN_EMAILS:}

# --- ML Service (Python FastAPI) ------------
ml.service.url=http://localhost:8000

# Optional server-side personalized explanations.
learning.gemini.key=${GEMINI_API_KEY:}
learning.gemini.model=${GEMINI_MODEL:}
spring.task.scheduling.pool.size=2
